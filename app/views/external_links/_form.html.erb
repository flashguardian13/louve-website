<table>
  <tr>
    <td class="content-form">
      <%= form_for(@content) do |f| %>
        <%= render 'shared/error_messages', object: @content %>

        <div>
          <%= f.label :url %><br/>
          <%= f.text_field :url %>
        </div>

        <div>
          <%= f.label :title %><br/>
          <%= f.text_field :title %>
        </div>

        <div>
          <%= f.label :description %><br/>
          <%= f.text_area :description %>
        </div>

        <div>
          <%= f.check_box :is_visible %>
          <%= f.label :is_visible, 'Make this link publicly visible' %>
        </div>

        <div>
          <%= f.submit 'Preview' %>
          <%= f.submit submit_text %>
        </div>

        <%= link_to 'Cancel', links_path %>
      <% end %>
    </td>

    <td class="content-preview">
      <%= render 'link', object: @content %>
    </td>
  </tr>
</table>
