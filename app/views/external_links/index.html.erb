<% provide(:title, 'Links') %>

<% if logged_in? && current_user.is_admin %>
  <div>
    Links surrounded by a <span class="container-invisible">dotted cyan border</span> are not publicly visible.
  </div>
  <%= link_to 'Create New Link', new_external_link_path %>
<% end %>

<% @links.sort { |a, b| b.created_at <=> a.created_at }.each do |link| %>
  <% next unless link.is_visible || (logged_in? && current_user.is_admin) %>
  <%= render 'link', object: link %>
<% end %>
