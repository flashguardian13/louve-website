<% provide(:title, 'Users') %>

<table>
  <% @users.each do |user| %>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Type</th>
    </tr>
    <tr>
      <td><%= user.name %></td>
      <td><%= user.email %></td>
      <td><%= user.is_admin ? 'Admin' : 'User' %></td>
    </tr>
  <% end %>
<table>
