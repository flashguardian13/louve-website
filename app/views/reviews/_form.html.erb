<div>
  <%= form_for [@publication, @content] do |f| %>
    <%= render 'shared/error_messages', object: @content %>

    <div>
      <%= f.label :quote %><br/>
      <%= f.text_area :quote %>
    </div>

    <div>
      <%= f.label :attribution %><br/>
      <%= f.text_field :attribution %>
    </div>

    <div>
      <%= f.check_box :is_visible %>
      <%= f.label :is_visible, 'Make this review publicly visible' %>
    </div>

    <div>
      <%= f.submit 'Preview' %>
      <%= f.submit submit_text %>
    </div>

    <%= link_to 'Cancel', publication_path(@publication) %>
  <% end %>
</div>

<div>
  <%= render 'review', object: @content %>
</div>
