<div class="review <%= object.is_visible ? '' : 'container-invisible' %>">
  <div "review-quote">
    <%= object.quote.bbcode_to_html.html_safe rescue object.quote %>
  </div>
  <div "review-attribution">
    -- <%= object.attribution %>
  </div>
  <% if object.persisted? && logged_in_as_admin? %>
    <% if object.is_visible %>
      <%= link_to 'Hide', publication_review_path(object.publication, object, review: {is_visible: false}), method: :patch, class: 'hide-review-link' %>
    <% else %>
      <%= link_to 'Show', publication_review_path(object.publication, object, review: {is_visible: true}), method: :patch, class: 'show-review-link' %>
    <% end %>
    <%= link_to 'Edit', edit_publication_review_path(object.publication, object), class: 'edit-review-link' %>
    <%= link_to 'Delete', publication_review_path(object.publication, object), method: :delete, class: 'delete-review-link',
      data: { confirm: 'Really delete this review?' } %>
  <% end %>
</div>
