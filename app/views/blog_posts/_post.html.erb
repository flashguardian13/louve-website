<div class="post-container <%= object.is_visible ? '' : 'container-invisible' %>">
  <div class="post-header clearfix">
    <div class="post-title">
      <%= link_to object.title, blog_post_path(object) %>
    </div>
    <div class="post-date">
      <% if object.persisted? %>
        <%= object.created_at.strftime('%A, %B %e, %Y, %l:%M:%S %p') %><br/>
        <% if logged_in_as_admin? %>
          <% if object.is_visible %>
            <%= link_to 'Hide', blog_post_path(object, blog_post: {is_visible: false}), method: :patch %>
          <% else %>
            <%= link_to 'Show', blog_post_path(object, blog_post: {is_visible: true}), method: :patch %>
          <% end %>
          <%= link_to 'Edit', edit_blog_post_path(object) %>
          <%= link_to 'Delete', blog_post_path(object), method: :delete,
            data: { confirm: 'Really delete this post?' } %>
        <% end %>
      <% else %>
        <%= Time.now.strftime('%A, %B %e, %Y, %l:%M:%S %p') %>
      <% end %>
    </div>
  </div>
  <div class="post-content">
    <%= object.content.bbcode_to_html.html_safe rescue object.content %>
  </div>
</div>
