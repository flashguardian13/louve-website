<div class="post-container">
  <div class="post-header clearfix">
    <div class="post-title">
      <%= object.title %>
    </div>
    <div class="post-date">
      <% if object.persisted? %>
        <%= object.created_at.strftime('%A, %B %e, %Y, %l:%M:%S %p') %><br/>
        <% if logged_in? && current_user.is_admin %>
          <%= link_to 'Edit', edit_blog_post_path(object) %>
          <%= link_to 'Delete', blog_post_path(object), method: :delete,
            data: { confirm: 'Really delete this post?' } %>
        <% end %>
      <% else %>
        <%= Time.now.strftime('%A, %B %e, %Y, %l:%M:%S %p') %>
      <% end %>
    </div>
  </div>
  <div class="post-content">
    <%= object.content.bbcode_to_html.html_safe rescue object.content %>
  </div>
</div>
