<header>
  <div class="banner">
    <%= link_to image_tag("pagelogo_02_01_830w_posterize24.png", id: "logo"), root_path %>
    <div id="banner-subtitle">Author, Dreamer, Spiritual Futurist</div>
  </div>
  <% if logged_in? %>
    <div class="center">
      You are signed in as <%= current_user.name %>.
      <%= link_to "Sign out", logout_path %>
    </div>
  <% end %>
  <div class="navbar">
    <%= render 'layouts/nav_links' %>
  </div>
</header>
