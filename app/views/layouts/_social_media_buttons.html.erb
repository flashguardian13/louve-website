<div class="center">
  <div class="social-media-bar">
    <div class="g-plusone-container">
      <div class="g-plus" data-href="<%= object %>" data-action="share"></div>
    </div>
    <div class="twitter-container">
      <a class="twitter-share-button" data-url="<%= object %>" href="https://twitter.com/intent/tweet" data-text="Rhiannon Louve Official Website">Share on Twitter</a>
    </div>
    <%= link_to image_tag('email_icon.png'), "mailto:?subject=#{u "Shared content from Rhiannon Louve's website"}&body=#{u "I would like to share this with you:\n\n#{object}\n\nPlease take a look when you can. Thanks!"}", { target: '_blank', class: 'email-share-container', id: 'email-share-button' } %>
    <div class="fb-like-container">
      <div class="fb-like" data-href="<%= object %>" data-layout="standard" data-action="like" data-size="small" data-show-faces="true" data-share="true"></div>
    </div>
  </div>
</div>
