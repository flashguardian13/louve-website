<div>
  <%= form_for(@content) do |f| %>
    <%= render 'shared/error_messages', object: @content %>

    <div>
      <%= f.label :title %><br/>
      <%= f.text_field :title %>
    </div>

    <div>
      <%= f.label :image %><br/>
      <%= f.text_field :image %>
    </div>

    <div>
      <%= f.label :short_description %><br/>
      <%= f.text_area :short_description %>
    </div>

    <div>
      <%= f.label :long_description %><br/>
      <%= f.text_area :long_description %>
    </div>

    <div>
      <%= f.label :sort_index %><br/>
      <%= f.text_field :sort_index %>
      <div>
        Publications will be displayed in order of sort index (descending) first, then by creation date (descending).
      </div>
    </div>

    <div>
      <%= f.check_box :is_visible %>
      <%= f.label :is_visible, 'Make this publication publicly visible' %>
    </div>

    <div>
      <%= f.submit 'Preview' %>
      <%= f.submit submit_text %>
    </div>

    <%= link_to 'Cancel', publications_path %>
  <% end %>
</div>

<div>
  <%= render 'publication', object: @content %>
</div>
