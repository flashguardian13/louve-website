<% provide(:title, 'Publications') %>

<% if logged_in_as_admin? %>
  <div>
    Publications surrounded by a <span class="container-invisible">dotted cyan border</span> are not publicly visible.
  </div>
  <%= link_to 'Add New Publication', new_publication_path, id: 'new-publication-link' %>
<% end %>

<% if @contents.empty? %>
  <div>
    No publications have been added yet.
  </div>
<% else %>
  <% @contents.sort { |a, b| a.sort_order(b) }.each do |publication| %>
    <% next unless publication.is_visible || logged_in_as_admin? %>
    <%= render 'publication', object: publication %>
  <% end %>
<% end %>
